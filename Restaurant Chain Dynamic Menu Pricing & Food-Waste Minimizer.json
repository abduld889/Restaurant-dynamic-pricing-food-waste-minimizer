    {
      "parameters": {
        "jsCode": "const today = new Date();\nconst daysBetween = (a,b) => Math.ceil((new Date(a) - new Date(b)) / 86400000);\n\nreturn $input.all().map(item => {\n  const r = item.json;\n  const daysToExpiry = r.expiry_date ? daysBetween(r.expiry_date, today) : 999;\n  const stock = Number(r.current_stock || 0);\n  const price = Number(r.current_price || 0);\n  const forecast = Number(r.forecast_units || 0);\n\n  // Firecrawl search results vary by version. We keep the calculation\n  // deterministic and use a competitor price supplied in the scraped\n  // result when one is available.\n  const text = JSON.stringify(r);\n  const matches = [...text.matchAll(/(?:₦|NGN|N)?\\s?([0-9]{1,3}(?:,[0-9]{3})+(?:\\.\\d+)?|[0-9]{3,6}(?:\\.\\d+)?)/g)];\n  const candidatePrices = matches\n    .map(m => Number(String(m[1]).replace(/,/g,'')))\n    .filter(n => n >= 1000 && n <= 100000);\n\n  const competitorPrice = candidatePrices.length\n    ? candidatePrices.reduce((a,b) => a+b,0) / candidatePrices.length\n    : null;\n\n  const wasteRisk = Math.max(0, daysToExpiry <= 0 ? stock * 10 : (stock / Math.max(daysToExpiry,1)));\n  const competitiveGap = competitorPrice === null ? null : price - competitorPrice;\n\n  return {\n    json: {\n      ...r,\n      days_to_expiry: daysToExpiry,\n      waste_risk_score: Number(wasteRisk.toFixed(2)),\n      competitor_price: competitorPrice === null ? null : Number(competitorPrice.toFixed(2)),\n      competitive_gap: competitiveGap === null ? null : Number(competitiveGap.toFixed(2)),\n      demand_signal: forecast > stock ? \"HIGH\" : forecast >= stock * 0.6 ? \"MEDIUM\" : \"LOW\"\n    }\n  };\n});"
      },

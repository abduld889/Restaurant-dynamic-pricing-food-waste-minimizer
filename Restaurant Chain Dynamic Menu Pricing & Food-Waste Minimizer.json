    {
      "parameters": {
        "operation": "executeQuery",
        "query": " SELECT\n    i.location_id,\n    i.location_name,\n    i.location_address,\n    i.ingredient_id,\n    i.ingredient_name,\n    i.current_stock,\n    i.unit,\n    i.expiry_date,\n    i.dish_id,\n    i.dish_name,\n    i.current_price,\n    i.competitor_search_url,\n    i.pos_update_url,\n    COALESCE(d.forecast_units, 10) AS forecast_units,\n    COALESCE(d.forecast_confidence, 0.70) AS forecast_confidence\nFROM restaurant_inventory AS i\nLEFT JOIN restaurant_demand_forecast AS d\n    ON d.location_id = i.location_id\n    AND d.dish_id = i.dish_id\nWHERE i.expiry_date >= CURRENT_DATE\n    AND i.current_stock > 0\nORDER BY i.location_id, i.expiry_date;",
        "options": {}
      },
